# Flask
SECRET_KEY=troque-por-uma-chave-segura-de-32-chars
APP_BASE_URL=https://seu-projeto.vercel.app

# Astra DB (DataStax) — deixe em branco para usar modo local (in-memory)
ASTRA_DB_API_ENDPOINT=https://SEU_DB_ID-us-east-2.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=seu-token-do-astra
ASTRA_DB_KEYSPACE=default_keyspace
ASTRA_DB_COLLECTION_USERS=taxistas
ASTRA_DB_COLLECTION_RECEIPTS=recibos

# Stripe — obtenha em https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# IDs dos preços criados no Stripe Dashboard
# Produto: "Recibo Táxi Pro" — cobrança mensal
STRIPE_PRO_PRICE_ID=price_...
# O plano Business saiu de venda. Quem já assina continua ativo pela Stripe;
# o app não abre checkout novo para ele.

# ── E-mail ──────────────────────────────────────────────────────────────────
# Resend é o caminho principal (API HTTP: um POST, em vez do handshake do SMTP).
RESEND_API_KEY=re_...
# Enquanto o domínio não estiver verificado no Resend, onboarding@resend.dev só
# entrega para o e-mail dono da conta.
EMAIL_FROM=nao-responda@recibotaxi.com.br

# SMTP fica como alternativa, caso troque de provedor. Ignorado se houver RESEND_API_KEY.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cron da Vercel — protege /tarefas/limpeza, que apaga recibos do gerador
# público vencidos (12 meses). Sem esta variável a rota responde 503.
CRON_SECRET=gere-um-valor-aleatorio-longo
