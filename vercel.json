{
  "version": 2,
  "builds": [
    {
      "src": "public/static/**",
      "use": "@vercel/static"
    },
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/public/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "crons": [
    {
      "path": "/tarefas/limpeza",
      "schedule": "0 4 * * *"
    }
  ],
  "regions": [
    "gru1"
  ]
}
